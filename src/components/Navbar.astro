---
---

<header class="sticky top-0 z-50 border-b border-[#dfe6dd] bg-[#f7f4ec]/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8">

    <!-- Brand -->
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#173b2a] text-white shadow-sm">
        <span class="font-serif text-xl">B</span>
      </div>

      <div class="leading-none">
        <div class="font-serif text-xl font-bold text-[#173b2a]">
          Best In Lawn
        </div>

        <div class="mt-1 text-[9px] font-bold uppercase tracking-[0.2em] text-[#657168]">
          Lawn • Cabin • Commercial
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 lg:flex">
      <a
        href="/"
        class="text-sm font-semibold text-[#1d2922] transition hover:text-[#477b50]"
      >
        Home
      </a>

      <a
        href="/services/lawn-care"
        class="text-sm font-semibold text-[#1d2922] transition hover:text-[#477b50]"
      >
        Lawn Care
      </a>

      <a
        href="/services/cabin-care"
        class="text-sm font-semibold text-[#1d2922] transition hover:text-[#477b50]"
      >
        Cabin Care
      </a>

      <a
        href="/services/commercial"
        class="text-sm font-semibold text-[#1d2922] transition hover:text-[#477b50]"
      >
        Commercial
      </a>

      <a
        href="/areas/fargo"
        class="text-sm font-semibold text-[#1d2922] transition hover:text-[#477b50]"
      >
        Service Areas
      </a>
    </nav>

    <!-- Desktop CTA -->
    <a
      href="/contact"
      class="hidden rounded-full bg-[#173b2a] px-5 py-3 text-sm font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-[#0e291d] hover:shadow-lg md:inline-flex"
    >
      Get a Free Estimate
    </a>

    <!-- Mobile Button -->
    <button
      id="menu-button"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#dfe6dd] bg-white text-[#173b2a] lg:hidden"
    >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>

      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="hidden h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden border-t border-[#dfe6dd] bg-[#f7f4ec] lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-5">

      <a
        href="/"
        class="border-b border-[#dfe6dd] py-4 text-base font-semibold text-[#173b2a]"
      >
        Home
      </a>

      <a
        href="/services/lawn-care"
        class="border-b border-[#dfe6dd] py-4 text-base font-semibold text-[#173b2a]"
      >
        Lawn Care
      </a>

      <a
        href="/services/cabin-care"
        class="border-b border-[#dfe6dd] py-4 text-base font-semibold text-[#173b2a]"
      >
        Cabin Care
      </a>

      <a
        href="/services/commercial"
        class="border-b border-[#dfe6dd] py-4 text-base font-semibold text-[#173b2a]"
      >
        Commercial
      </a>

      <a
        href="/areas/fargo"
        class="border-b border-[#dfe6dd] py-4 text-base font-semibold text-[#173b2a]"
      >
        Service Areas
      </a>

      <a
        href="/contact"
        class="mt-5 inline-flex justify-center rounded-full bg-[#173b2a] px-5 py-3.5 font-bold text-white"
      >
        Get a Free Estimate
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';

    button.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });
</script>
