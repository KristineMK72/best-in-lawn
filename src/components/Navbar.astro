    place-items: center;
    background: var(--green);
    color: white;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-copy strong {
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .brand-copy small {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-left: auto;
  }

  .desktop-nav a {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 150ms ease;
  }

  .desktop-nav a:hover {
    color: var(--green-mid);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 17px;
    background: var(--green);
    color: white;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-cta span {
    font-size: 1rem;
  }

  .menu-button {
    display: none;
    width: 45px;
    height: 45px;
    border: 0;
    background: var(--green);
    cursor: pointer;
  }

  .menu-button span {
    width: 19px;
    height: 2px;
    display: block;
    margin: 5px auto;
    background: white;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1050px) {
    .desktop-nav,
    .nav-cta {
      display: none;
    }

    .menu-button {
      display: block;
    }

    .mobile-menu {
      padding: 8px 20px 24px;
      background: var(--cream);
    }

    .mobile-menu.open {
      display: grid;
    }

    .mobile-menu > a {
      padding: 17px 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.8rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .mobile-estimate {
      margin-top: 14px;
      padding: 18px !important;
      border: 0 !important;
      background: var(--green);
      color: white;
    }

    .mobile-estimate span {
      margin-left: auto;
    }
  }

  @media (max-width: 500px) {
    .nav-shell {
      width: calc(100% - 28px);
      min-height: 72px;
    }

    .brand-copy small {
      display: none;
    }

    .brand-copy strong {
      font-size: 0.78rem;
    }
  }
</style>
