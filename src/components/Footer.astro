---
const currentYear = new Date().getFullYear();
---
<!-- Using a vibrant green to match the original branding -->
<footer class="bg-[#1b6b2b] text-white py-16 mt-auto border-t-8 border-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-center md:text-left mb-12">
      <!-- Locations column matching the original site -->
      <div class="flex flex-col items-center">
        <h3 class="text-2xl font-bold uppercase tracking-widest mb-6 inline-block border-b-4 border-white pb-1">Locations</h3>
        <div class="grid grid-cols-2 gap-x-12 gap-y-4 text-lg font-bold">
          <div>&bull; MOORHEAD</div>
          <div>&bull; HORACE</div>
          <div>&bull; FARGO</div>
          <div>&bull; HARWOOD</div>
          <div>&bull; WEST FARGO</div>
          <div>&bull; AND MORE</div>
        </div>
      </div>

      <!-- Contact column matching the original site -->
      <div class="flex flex-col items-center">
        <h3 class="text-2xl font-bold uppercase tracking-widest mb-6 inline-block border-b-4 border-white pb-1">Contact</h3>
        <div class="space-y-4 text-lg font-bold text-center">
          <a href="mailto:bestinlawn@gmail.com" class="block hover:text-gray-200 border-b-2 border-white pb-1">BESTINLAWN@GMAIL.COM</a>
          <a href="tel:7012386904" class="block hover:text-gray-200 border-b-2 border-white pb-1">(701) 238-6904</a>
        </div>
        
        <!-- Social Icons Placeholder -->
        <div class="flex space-x-4 mt-8">
          <a href="#" class="w-12 h-12 border-2 border-white rounded-md flex items-center justify-center hover:bg-white hover:text-[#1b6b2b] transition">
            <span class="font-bold text-xl">f</span>
          </a>
          <a href="#" class="w-12 h-12 border-2 border-white rounded-md flex items-center justify-center hover:bg-white hover:text-[#1b6b2b] transition">
            <span class="font-bold text-xl">IG</span>
          </a>
        </div>
      </div>
    </div>

    <div class="text-sm font-medium text-center mt-8 pt-8 border-t border-white/30">
      &copy; {currentYear} Best In Lawn. All rights reserved.
    </div>
  </div>
</footer>
