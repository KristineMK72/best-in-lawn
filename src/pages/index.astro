---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Lawn Care',
    description:
      'Consistent, professional lawn care that keeps your property looking sharp and your lawn healthy all season long.',
    image:
      'https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=1800&q=85',
    href: '/services/lawn-care/',
    label: 'Residential',
  },
  {
    number: '02',
    title: 'Cabin Care',
    description:
      'Reliable care for lake homes, cabins and vacation properties when you are there—and when you are not.',
    image:
      'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1800&q=85',
    href: '/services/cabin-care/',
    label: 'Lake Properties',
  },
  {
    number: '03',
    title: 'Commercial',
    description:
      'Professional grounds care that keeps your business property clean, welcoming and looking its best.',
    image:
      'https://images.unsplash.com/photo-1589923188900-85dae523342b?auto=format&fit=crop&w=1800&q=85',
    href: '/services/commercial/',
    label: 'Business',
  },
];
---

<BaseLayout
  title="Best In Lawn | Lawn, Cabin & Property Care"
  description="Professional lawn, cabin and property care for homes, lake properties and businesses."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="hero">

    <div class="hero-background image-wrap">
      <img
        src="https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=2400&q=90"
        alt="Freshly maintained green lawn"
      />
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content container">

      <div class="hero-top">

        <span class="eyebrow">
          Lawn • Cabin • Property Care
        </span>

        <span class="hero-location">
          Proudly serving the Lakes Area
        </span>

      </div>

      <div class="hero-title">

        <h1 class="display">
          BEST<br />
          <span>IN</span><br />
          LAWN<span class="period">.</span>
        </h1>

        <div class="hero-side">

          <p>
            Professional property care for lawns,
            cabins, lake homes and businesses.
          </p>

          <a href="#estimate" class="luxury-button light">
            Get A Free Estimate
            <span class="arrow">↗</span>
          </a>

        </div>

      </div>

      <div class="hero-bottom">

        <span>01</span>

        <span>PROPERTY CARE</span>

        <span>EST. WITH PRIDE</span>

      </div>

    </div>

  </section>


  <!-- =====================================================
       STATEMENT
       ===================================================== -->

  <section class="statement">

    <div class="container statement-grid">

      <div>
        <span class="section-number">
          01 / THE STANDARD
        </span>
      </div>

      <div>

        <h2 class="display">
          MORE<br />
          THAN<br />
          <span class="serif">MOWING.</span>
        </h2>

        <div class="statement-copy">

          <p>
            Your property is more than a yard. It is where you
            spend summer weekends, welcome friends, run your
            business and make memories.
          </p>

          <p>
            Best In Lawn provides dependable, detail-focused
            property care designed to keep your place looking
            its best.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SERVICES
       ===================================================== -->

  <section class="services">

    <div class="container services-heading">

      <div>
        <span class="section-number">
          02 / WHAT WE DO
        </span>
      </div>

      <h2 class="display">
        CARE FOR<br />
        EVERY<br />
        PROPERTY.
      </h2>

    </div>


    <div class="service-list">

      {services.map((service) => (

        <a href={service.href} class="service-item">

          <div class="service-image image-wrap">

            <img
              src={service.image}
              alt={service.title}
              loading="lazy"
            />

          </div>


          <div class="service-info">

            <div class="service-meta">
              <span>{service.number}</span>
              <span>{service.label}</span>
            </div>


            <h3 class="display">
              {service.title}
            </h3>


            <p>
              {service.description}
            </p>


            <span class="service-link">
              Explore Service
              <span>↗</span>
            </span>

          </div>

        </a>

      ))}

    </div>

  </section>


  <!-- =====================================================
       ABOUT BIL
       GRASS BACKGROUND
       ===================================================== -->

  <section class="about">

    <div class="about-background image-wrap">

      <img
        src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=2400&q=90"
        alt=""
        loading="lazy"
      />

    </div>

    <div class="about-overlay"></div>


    <div class="container about-inner">

      <div class="about-card">

        <div class="about-image">

          <img
            src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=85"
            alt="Beautifully maintained property"
            loading="lazy"
          />

          <div class="about-image-label">
            <span>03</span>
            <span>ABOUT BIL</span>
          </div>

        </div>


        <div class="about-content">

          <span class="section-number">
            03 / ABOUT BIL
          </span>

          <h2 class="display">
            A HIGHER<br />
            STANDARD OF<br />
            <span class="serif">CARE.</span>
          </h2>


          <p class="about-lead">
            Best In Lawn provides a high standard of lawn
            and cabin care with a commitment to excellence.
          </p>


          <p>
            We strive to exceed our customers' expectations
            through quality service, attention to detail and
            dependable customer care.
          </p>


          <p>
            We use the latest tools and techniques to deliver
            beautiful results while treating every property
            with the care and attention it deserves.
          </p>


          <div class="about-points">

            <div>
              <span>01</span>
              <strong>QUALITY SERVICE</strong>
            </div>

            <div>
              <span>02</span>
              <strong>ATTENTION TO DETAIL</strong>
            </div>

            <div>
              <span>03</span>
              <strong>INSURED &amp; EXPERIENCED</strong>
            </div>

          </div>


          <a href="/about/" class="text-link dark">
            Learn More About Best In Lawn →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       DIFFERENCE
       ===================================================== -->

  <section class="difference">

    <div class="container">

      <div class="difference-header">

        <span class="section-number">
          04 / THE DIFFERENCE
        </span>

        <h2 class="display">
          WE<br />
          SHOW<br />
          <span class="serif">UP.</span>
        </h2>

      </div>


      <div class="difference-grid">

        <div class="difference-item">

          <span class="big-number">
            01
          </span>

          <h3>
            RELIABLE
          </h3>

          <p>
            Consistent service you can count on.
            Your property should never feel like an afterthought.
          </p>

        </div>


        <div class="difference-item">

          <span class="big-number">
            02
          </span>

          <h3>
            DETAILS MATTER
          </h3>

          <p>
            Clean edges, finished spaces and attention to
            the little things that make a property stand out.
          </p>

        </div>


        <div class="difference-item">

          <span class="big-number">
            03
          </span>

          <h3>
            LOCAL CARE
          </h3>

          <p>
            We understand the properties, seasons and
            expectations of the communities we serve.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FEATURE IMAGE
       ===================================================== -->

  <section class="feature-image image-wrap">

    <img
      src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=90"
      alt="Beautiful cared-for property"
      loading="lazy"
    />

    <div class="feature-overlay">

      <span class="eyebrow">
        The Best In Lawn Standard
      </span>

      <h2 class="display">
        THIS IS<br />
        WHAT WELL-CARED-FOR<br />
        <span class="serif">LOOKS LIKE.</span>
      </h2>

    </div>

  </section>


  <!-- =====================================================
       PROCESS
       ===================================================== -->

  <section class="process">

    <div class="container">

      <div class="process-heading">

        <span class="section-number">
          05 / HOW IT WORKS
        </span>

        <h2 class="display">
          SIMPLE.<br />
          PROFESSIONAL.<br />
          <span class="serif">DONE.</span>
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-item">

          <span>01</span>

          <h3>
            TELL US ABOUT YOUR PROPERTY
          </h3>

          <p>
            Tell us what you need, where you're located
            and what you want your property to look like.
          </p>

        </div>


        <div class="process-item">

          <span>02</span>

          <h3>
            GET YOUR ESTIMATE
          </h3>

          <p>
            We'll talk through the work and put together
            a straightforward estimate.
          </p>

        </div>


        <div class="process-item">

          <span>03</span>

          <h3>
            ENJOY YOUR PROPERTY
          </h3>

          <p>
            We take care of the work so you can spend
            your time enjoying the property instead.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       SERVICE AREAS
       ===================================================== -->

  <section class="areas">

    <div class="container areas-grid">

      <div>

        <span class="section-number">
          06 / SERVICE AREAS
        </span>

        <h2 class="display">
          PROUDLY<br />
          SERVING<br />
          <span class="serif">
            THE LAKES AREA.
          </span>
        </h2>

      </div>


      <div class="area-list">

        <span>Moorhead</span>

        <span>Fargo</span>

        <span>West Fargo</span>

        <span>Horace</span>

        <span>Harwood</span>

        <a href="/areas/nisswa/">
          Nisswa
          <span>↗</span>
        </a>

        <span>Lakes Area</span>

        <span>And More</span>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FINAL CTA
       GRASS BACKGROUND
       ===================================================== -->

  <section
    class="final-cta"
    id="estimate"
  >

    <div class="cta-background image-wrap">

      <img
        src="https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=2400&q=90"
        alt=""
        loading="lazy"
      />

    </div>

    <div class="cta-overlay"></div>


    <div class="container cta-inner">

      <span class="eyebrow">
        Ready when you are
      </span>


      <h2 class="display">
        MAKE YOUR<br />
        PROPERTY<br />
        THE <span class="serif">BEST.</span>
      </h2>


      <p>
        Tell us a little about your property and what you need.
        We'll take it from there.
      </p>


      <div class="cta-actions">

        <a
          href="tel:+17012386904"
          class="luxury-button light"
        >
          Call (701) 238-6904
          <span class="arrow">↗</span>
        </a>


        <a
          href="mailto:bestinlawn@gmail.com"
          class="text-link"
        >
          Email Best In Lawn →
        </a>

      </div>

    </div>

  </section>

</BaseLayout>


<style>

/* =========================================================
   HERO — GRASS
   ========================================================= */

.hero {
  position: relative;

  min-height: 860px;

  overflow: hidden;

  color: white;

  background: var(--green-dark);
}

.hero-background {
  position: absolute;

  inset: 0;

  z-index: 0;
}

.hero-background img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;
}

.hero-overlay {
  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      180deg,
      rgba(7,28,18,0.48) 0%,
      rgba(7,28,18,0.12) 35%,
      rgba(7,28,18,0.72) 100%
    );
}

.hero-content {
  position: relative;

  z-index: 2;

  min-height: 860px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  padding-top: 50px;

  padding-bottom: 30px;
}

.hero-top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding-bottom: 25px;

  border-bottom:
    1px solid
    rgba(255,255,255,0.35);
}

.hero-location {
  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.hero-title {
  display: grid;

  grid-template-columns:
    1fr
    260px;

  gap: 50px;

  align-items: end;

  padding-top: 42px;

  padding-bottom: 48px;
}

.hero h1 {
  margin: 0;

  font-size:
    clamp(
      4.8rem,
      11vw,
      10rem
    );

  line-height: 0.82;

  letter-spacing: -0.065em;
}

.hero h1 span:not(.period) {
  color: var(--sage);
}

.hero .period {
  color: var(--gold);
}

.hero-side {
  padding-bottom: 12px;
}

.hero-side p {
  margin: 0 0 24px;

  color: rgba(255,255,255,0.86);

  font-size: 0.9rem;

  line-height: 1.7;
}

.hero-bottom {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding-top: 20px;

  border-top:
    1px solid
    rgba(255,255,255,0.35);

  font-size: 0.62rem;

  font-weight: 900;

  letter-spacing: 0.15em;
}


/* =========================================================
   STATEMENT
   ========================================================= */

.statement {
  padding: 135px 0;

  background: white;
}

.statement-grid {
  display: grid;

  grid-template-columns:
    25%
    1fr;

  gap: 30px;
}

.statement h2 {
  margin: 0;

  font-size:
    clamp(
      4rem,
      8vw,
      8.5rem
    );

  line-height: 0.86;

  letter-spacing: -0.055em;
}

.statement-copy {
  max-width: 600px;

  margin-top: 50px;

  margin-left: 28%;
}

.statement-copy p {
  margin: 0 0 18px;

  color: var(--muted);

  font-size: 1rem;

  line-height: 1.8;
}


/* =========================================================
   SERVICES
   ========================================================= */

.services {
  padding: 130px 0;

  background: var(--cream);
}

.services-heading {
  display: grid;

  grid-template-columns:
    25%
    1fr;

  gap: 30px;

  margin-bottom: 80px;
}

.services-heading h2 {
  margin: 0;

  font-size:
    clamp(
      3.8rem,
      7.5vw,
      8rem
    );

  line-height: 0.88;

  letter-spacing: -0.055em;
}

.service-list {
  width:
    min(
      1250px,
      calc(100% - 40px)
    );

  margin: auto;
}

.service-item {
  display: grid;

  grid-template-columns:
    1.2fr
    0.8fr;

  min-height: 560px;

  margin-bottom: 28px;

  background: white;

  text-decoration: none;

  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease;
}

.service-item:hover {
  transform: translateY(-5px);

  box-shadow:
    0 20px 50px
    rgba(7,28,18,0.08);
}

.service-item:nth-child(even) {
  grid-template-columns:
    0.8fr
    1.2fr;
}

.service-item:nth-child(even)
.service-image {
  order: 2;
}

.service-image {
  min-height: 500px;
}

.service-info {
  padding: 52px;

  display: flex;

  flex-direction: column;

  justify-content: center;
}

.service-meta {
  display: flex;

  justify-content: space-between;

  margin-bottom: 48px;

  color: var(--muted);

  font-size: 0.62rem;

  font-weight: 900;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}

.service-info h3 {
  margin: 0 0 22px;

  color: var(--green);

  font-size:
    clamp(
      3rem,
      5vw,
      5.8rem
    );

  line-height: 0.88;

  letter-spacing: -0.055em;
}

.service-info p {
  max-width: 420px;

  margin: 0 0 32px;

  color: var(--muted);

  line-height: 1.75;
}

.service-link {
  font-size: 0.7rem;

  font-weight: 900;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  color: var(--text);
}

.service-link span {
  margin-left: 8px;

  font-size: 1rem;
}


/* =========================================================
   ABOUT BIL — GRASS FIELD
   ========================================================= */

.about {
  position: relative;

  overflow: hidden;

  padding: 120px 0;

  min-height: 900px;

  background: var(--green-dark);
}

.about-background {
  position: absolute;

  inset: 0;

  z-index: 0;
}

.about-background img {
  width: 100%;

  height: 100%;

  object-fit: cover;

  transform: scale(1.03);
}

.about-overlay {
  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(7,28,18,0.78),
      rgba(7,28,18,0.32)
    );
}

.about-inner {
  position: relative;

  z-index: 2;
}

.about-card {
  display: grid;

  grid-template-columns:
    0.82fr
    1.18fr;

  max-width: 1250px;

  margin: auto;

  background: rgba(255,255,255,0.96);

  box-shadow:
    0 30px 90px
    rgba(0,0,0,0.22);
}

.about-image {
  position: relative;

  min-height: 700px;

  overflow: hidden;
}

.about-image img {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;
}

.about-image-label {
  position: absolute;

  left: 25px;

  right: 25px;

  bottom: 24px;

  z-index: 2;

  display: flex;

  justify-content: space-between;

  color: white;

  font-size: 0.62rem;

  font-weight: 900;

  letter-spacing: 0.14em;

  text-transform: uppercase;

  text-shadow:
    0 1px 10px
    rgba(0,0,0,0.35);
}

.about-content {
  padding: 70px;

  display: flex;

  flex-direction: column;

  justify-content: center;
}

.about-content h2 {
  margin: 28px 0 38px;

  font-size:
    clamp(
      3.8rem,
      6vw,
      7rem
    );

  line-height: 0.86;

  letter-spacing: -0.055em;
}

.about-content h2 .serif {
  color: var(--green);
}

.about-content p {
  max-width: 560px;

  margin: 0 0 18px;

  color: var(--muted);

  line-height: 1.8;
}

.about-content .about-lead {
  color: var(--text);

  font-size: 1.1rem;

  line-height: 1.75;

  margin-bottom: 25px;
}

.about-points {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 20px;

  margin: 42px 0 38px;

  padding-top: 25px;

  border-top:
    1px solid var(--line);
}

.about-points div {
  display: flex;

  flex-direction: column;

  gap: 12px;
}

.about-points span {
  color: var(--green);

  font-size: 1.8rem;

  font-weight: 900;

  letter-spacing: -0.08em;
}

.about-points strong {
  font-size: 0.62rem;

  line-height: 1.35;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.text-link.dark {
  color: var(--green);
}


/* =========================================================
   DIFFERENCE
   ========================================================= */

.difference {
  padding: 135px 0;

  background: var(--green);

  color: white;
}

.difference-header {
  display: grid;

  grid-template-columns:
    25%
    1fr;

  gap: 30px;
}

.difference-header h2 {
  margin: 0;

  font-size:
    clamp(
      4.2rem,
      9vw,
      10rem
    );

  line-height: 0.84;

  letter-spacing: -0.06em;
}

.difference-header .serif {
  color: var(--sage);
}

.difference-grid {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  margin-top: 90px;

  border-top:
    1px solid
    rgba(255,255,255,0.25);
}

.difference-item {
  padding: 42px 35px 0 0;

  border-right:
    1px solid
    rgba(255,255,255,0.25);
}

.difference-item:not(:first-child) {
  padding-left: 35px;
}

.difference-item:last-child {
  border-right: 0;
}

.big-number {
  display: block;

  margin-bottom: 42px;

  color: var(--sage);

  font-size: 2.7rem;

  font-weight: 900;

  letter-spacing: -0.08em;
}

.difference-item h3 {
  margin: 0 0 15px;

  font-size: 1rem;

  letter-spacing: 0.08em;
}

.difference-item p {
  max-width: 330px;

  color: #b9c8bd;

  line-height: 1.7;
}


/* =========================================================
   FEATURE IMAGE
   ========================================================= */

.feature-image {
  height: 75vh;

  min-height: 580px;

  position: relative;
}

.feature-overlay {
  position: absolute;

  inset: 0;

  z-index: 2;

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 7%;

  background:
    linear-gradient(
      90deg,
      rgba(7,28,18,0.68),
      rgba(7,28,18,0.04)
    );

  color: white;
}

.feature-overlay h2 {
  margin: 25px 0 0;

  font-size:
    clamp(
      3.5rem,
      7vw,
      8rem
    );

  line-height: 0.88;

  letter-spacing: -0.055em;
}

.feature-overlay .serif {
  color: var(--sage);
}


/* =========================================================
   PROCESS
   ========================================================= */

.process {
  padding: 135px 0;

  background: white;
}

.process-heading {
  display: grid;

  grid-template-columns:
    25%
    1fr;

  gap: 30px;
}

.process-heading h2 {
  margin: 0;

  font-size:
    clamp(
      3.8rem,
      7.5vw,
      8rem
    );

  line-height: 0.87;

  letter-spacing: -0.055em;
}

.process-heading .serif {
  color: var(--green);
}

.process-grid {
  display: grid;

  grid-template-columns:
    repeat(3,1fr);

