---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Best In Lawn | Lawn, Cabin & Commercial Care';
const description =
  'Professional lawn care, cabin care, and commercial property maintenance serving Fargo, Moorhead, West Fargo, and the surrounding Lakes Area.';
---

<BaseLayout title={title} description={description}>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#173b2a]">

    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1592424001807-160751307d88?q=80&w=2200&auto=format&fit=crop"
        alt="Freshly maintained green lawn"
        class="h-full w-full object-cover opacity-40"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-[#0e291d]/95 via-[#173b2a]/80 to-[#173b2a]/30"></div>
    </div>

    <div class="relative mx-auto grid min-h-[680px] max-w-7xl items-center gap-12 px-5 py-24 sm:px-6 lg:grid-cols-2 lg:px-8">

      <div class="max-w-2xl">

        <p class="mb-5 text-sm font-bold uppercase tracking-[0.2em] text-[#c7a45b]">
          Professional Property Care
        </p>

        <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">
          Your property deserves to look its best.
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-8 text-white/80 sm:text-xl">
          Reliable lawn, cabin, and commercial property care for homeowners
          and businesses throughout the Fargo–Moorhead area and surrounding
          communities.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">

          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full bg-white px-7 py-4 font-bold text-[#173b2a] shadow-xl transition hover:-translate-y-1 hover:bg-[#f7f4ec]"
          >
            Get a Free Estimate
            <span class="ml-2">→</span>
          </a>

          <a
            href="#services"
            class="inline-flex items-center justify-center rounded-full border border-white/30 bg-white/10 px-7 py-4 font-bold text-white backdrop-blur-sm transition hover:bg-white/20"
          >
            Explore Services
          </a>

        </div>

      </div>

      <!-- Hero logo panel -->
      <div class="hidden justify-center lg:flex">
        <div class="relative">

          <div class="absolute -inset-6 rounded-full border border-white/10"></div>
          <div class="absolute -inset-12 rounded-full border border-white/5"></div>

          <div class="relative flex h-80 w-80 items-center justify-center rounded-full bg-white/95 p-10 shadow-2xl">
            <img
              src="/logo.png"
              alt="Best In Lawn"
              class="h-full w-full object-contain"
            />
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- TRUST BAR -->
  <section class="border-b border-[#dfe6dd] bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-[#dfe6dd] px-5 sm:grid-cols-4 sm:px-6 lg:px-8">

      <div class="px-4 py-7 text-center">
        <div class="font-serif text-xl text-[#173b2a]">Reliable</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#657168]">
          Dependable Service
        </div>
      </div>

      <div class="px-4 py-7 text-center">
        <div class="font-serif text-xl text-[#173b2a]">Experienced</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#657168]">
          Attention to Detail
        </div>
      </div>

      <div class="px-4 py-7 text-center">
        <div class="font-serif text-xl text-[#173b2a]">Local</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#657168]">
          Community Focused
        </div>
      </div>

      <div class="px-4 py-7 text-center">
        <div class="font-serif text-xl text-[#173b2a]">Free Estimates</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#657168]">
          Let's Talk
        </div>
      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="bg-[#f7f4ec] py-24">
    <div class="section-wrap">

      <div class="mx-auto max-w-3xl text-center">

        <p class="eyebrow">
          A better-looking property starts with the details.
        </p>

        <h2 class="mt-4 text-4xl font-bold leading-tight text-[#173b2a] sm:text-5xl">
          Spend your time enjoying your property.
          <span class="italic text-[#477b50]">We'll handle the care.</span>
        </h2>

        <p class="mt-7 text-lg leading-8 text-[#657168]">
          From routine lawn maintenance to exterior cabin care and
          commercial property service, Best In Lawn helps keep your
          property looking cared for season after season.
        </p>

      </div>

    </div>
  </section>


  <!-- SERVICES -->
  <section id="services" class="bg-white py-24">
    <div class="section-wrap">

      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">

        <div>
          <p class="eyebrow">
            What We Do
          </p>

          <h2 class="mt-3 text-4xl font-bold text-[#173b2a] sm:text-5xl">
            Services built around your property.
          </h2>
        </div>

        <a
          href="/contact"
          class="font-bold text-[#477b50] transition hover:text-[#173b2a]"
        >
          Request a custom service plan →
        </a>

      </div>


      <div class="mt-12 grid gap-7 md:grid-cols-3">

        <!-- Lawn -->
        <a
          href="/services/lawn-care"
          class="group overflow-hidden rounded-3xl border border-[#dfe6dd] bg-[#f7f4ec] transition duration-300 hover:-translate-y-2 hover:shadow-2xl"
        >

          <div class="relative h-60 overflow-hidden">

            <img
              src="https://images.unsplash.com/photo-1558904541-efa843a96f01?q=80&w=1200&auto=format&fit=crop"
              alt="Healthy green lawn"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-[#173b2a]/70 to-transparent"></div>

            <span class="absolute bottom-5 left-5 rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#173b2a]">
              Residential
            </span>

          </div>

          <div class="p-7">

            <h3 class="text-3xl font-bold text-[#173b2a]">
              Lawn Care
            </h3>

            <p class="mt-4 leading-7 text-[#657168]">
              Keep your lawn healthy, neat, and ready to enjoy with
              dependable mowing, trimming, and seasonal maintenance.
            </p>

            <div class="mt-6 font-bold text-[#477b50]">
              Explore Lawn Care →
            </div>

          </div>
        </a>


        <!-- Cabin -->
        <a
          href="/services/cabin-care"
          class="group overflow-hidden rounded-3xl border border-[#dfe6dd] bg-[#f7f4ec] transition duration-300 hover:-translate-y-2 hover:shadow-2xl"
        >

          <div class="relative h-60 overflow-hidden">

            <img
              src="https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?q=80&w=1200&auto=format&fit=crop"
              alt="Cabin exterior surrounded by trees"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-[#173b2a]/70 to-transparent"></div>

            <span class="absolute bottom-5 left-5 rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#173b2a]">
              Lakes Area
            </span>

          </div>

          <div class="p-7">

            <h3 class="text-3xl font-bold text-[#173b2a]">
              Cabin Care
            </h3>

            <p class="mt-4 leading-7 text-[#657168]">
              Take care of the outside of your cabin while you spend
              more time enjoying the lake, woods, and everything around it.
            </p>

            <div class="mt-6 font-bold text-[#477b50]">
              Explore Cabin Care →
            </div>

          </div>
        </a>


        <!-- Commercial -->
        <a
          href="/services/commercial"
          class="group overflow-hidden rounded-3xl border border-[#dfe6dd] bg-[#f7f4ec] transition duration-300 hover:-translate-y-2 hover:shadow-2xl"
        >

          <div class="relative h-60 overflow-hidden">

            <img
              src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=1200&auto=format&fit=crop"
              alt="Professionally maintained commercial property"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-[#173b2a]/70 to-transparent"></div>

            <span class="absolute bottom-5 left-5 rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#173b2a]">
              Businesses
            </span>

          </div>

          <div class="p-7">

            <h3 class="text-3xl font-bold text-[#173b2a]">
              Commercial
            </h3>

            <p class="mt-4 leading-7 text-[#657168]">
              Maintain a clean, professional first impression with
              dependable care for commercial lots and properties.
            </p>

            <div class="mt-6 font-bold text-[#477b50]">
              Explore Commercial →
            </div>

          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- WHY BEST IN LAWN -->
  <section class="bg-[#e8efe6] py-24">
    <div class="section-wrap">

      <div class="grid items-center gap-14 lg:grid-cols-2">

        <div>

          <p class="eyebrow">
            Why Best In Lawn
          </p>

          <h2 class="mt-4 text-4xl font-bold leading-tight text-[#173b2a] sm:text-5xl">
            The little details make a big difference.
          </h2>

          <p class="mt-6 text-lg leading-8 text-[#657168]">
            Your property is an investment. It should look like one.
            We focus on dependable service, quality work, and the details
            that make a property feel cared for.
          </p>

          <div class="mt-8 space-y-5">

            <div class="flex gap-4">
              <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#173b2a] text-white">
                ✓
              </div>

              <div>
                <h3 class="font-bold text-[#173b2a]">
                  Attention to detail
                </h3>

                <p class="mt-1 text-sm leading-6 text-[#657168]">
                  We don't just check a box. We take pride in how the
                  finished property looks.
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#173b2a] text-white">
                ✓
              </div>

              <div>
                <h3 class="font-bold text-[#173b2a]">
                  Reliable service
                </h3>

                <p class="mt-1 text-sm leading-6 text-[#657168]">
                  Consistent property care means one less thing on
                  your list.
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#173b2a] text-white">
                ✓
              </div>

              <div>
                <h3 class="font-bold text-[#173b2a]">
                  Service tailored to you
                </h3>

                <p class="mt-1 text-sm leading-6 text-[#657168]">
                  We'll work with you to create a service plan that
                  fits your property and your needs.
                </p>
              </div>
            </div>

          </div>

        </div>


        <div class="relative">

          <div class="overflow-hidden rounded-[2rem] shadow-2xl">
            <img
              src="https://images.unsplash.com/photo-1558521958-0a228e77e984?q=80&w=1400&auto=format&fit=crop"
              alt="Beautifully maintained outdoor property"
              class="h-[500px] w-full object-cover"
            />
          </div>

          <div class="absolute -bottom-6 -left-4 rounded-2xl bg-white p-6 shadow-xl sm:-left-8">
            <div class="font-serif text-3xl font-bold text-[#173b2a]">
              Est. 2023
            </div>

            <div class="mt-1 text-xs font-bold uppercase tracking-wider text-[#657168]">
              Proudly serving our communities
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>


  <!-- SERVICE AREAS -->
  <section class="bg-white py-24">
    <div class="section-wrap text-center">

      <p class="eyebrow">
        Where We Work
      </p>

      <h2 class="mt-4 text-4xl font-bold text-[#173b2a] sm:text-5xl">
        Serving your corner of the region.
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[#657168]">
        Best In Lawn provides property care throughout Fargo, Moorhead,
        West Fargo, Horace, Harwood, the Lakes Area, and surrounding communities.
      </p>


      <div class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-3">

        {['Fargo', 'Moorhead', 'West Fargo', 'Horace', 'Harwood', 'Nisswa', 'Lakes Area'].map((area) => (
          <span class="rounded-full border border-[#dfe6dd] bg-[#f7f4ec] px-5 py-3 text-sm font-semibold text-[#173b2a]">
            {area}
          </span>
        ))}

      </div>

    </div>
  </section>


  <!-- FINAL CTA -->
  <section class="bg-[#173b2a] py-24">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-6">

      <p class="text-sm font-bold uppercase tracking-[0.2em] text-[#c7a45b]">
        Let's Get Started
      </p>

      <h2 class="mt-5 text-4xl font-bold leading-tight text-white sm:text-6xl">
        Let's make your property the best on the block.
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/70">
        Tell us what your property needs and we'll help you build
        a service plan that works for you.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">

        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full bg-white px-7 py-4 font-bold text-[#173b2a] transition hover:-translate-y-1 hover:bg-[#f7f4ec]"
        >
          Get a Free Estimate
          <span class="ml-2">→</span>
        </a>

        <a
          href="tel:7012386904"
          class="inline-flex items-center justify-center rounded-full border border-white/25 px-7 py-4 font-bold text-white transition hover:bg-white/10"
        >
          Call (701) 238-6904
        </a>

      </div>

    </div>
  </section>

</BaseLayout>
