---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Professional Lawn & Cabin Care | Best In Lawn";
const description = "Best In Lawn provides a high standard of lawn and cabin care services with a commitment to excellence. Serving Fargo, Moorhead, and the Lakes Area.";
---

<BaseLayout title={title} description={description}>
  
  <!-- HERO SECTION WITH LOGO -->
  <section class="relative bg-[#0f172a] h-[70vh] min-h-[500px] flex flex-col items-center justify-center">
    <div class="absolute inset-0 overflow-hidden">
      <!-- Grass background -->
      <img src="https://images.unsplash.com/photo-1592424001807-160751307d88?q=80&w=2000&auto=format&fit=crop" alt="Green grass" class="w-full h-full object-cover opacity-60" />
    </div>
    
    <div class="relative z-10 flex flex-col items-center">
      <!-- The Logo Image (Make sure logo.png is in your public folder!) -->
      <img src="/logo.png" alt="Best In Lawn Est 2023" class="w-64 h-64 md:w-80 md:h-80 object-contain drop-shadow-2xl mb-8" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
      
      <!-- Fallback text just in case the logo image doesn't load immediately -->
      <div class="hidden text-center bg-white p-8 rounded-full shadow-2xl border-8 border-[#1b6b2b]">
        <h1 class="text-4xl font-black text-[#1b6b2b] uppercase tracking-tighter">Best In Lawn</h1>
        <p class="text-sm font-bold uppercase tracking-widest mt-2">Est. 2023</p>
      </div>
    </div>
  </section>

  <!-- ABOUT BIL SECTION -->
  <section class="py-20 bg-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl shadow-xl p-10 md:p-16 text-center border-t-8 border-[#1b6b2b]">
        <h2 class="text-3xl font-black uppercase mb-8 inline-block border-b-4 border-black pb-2">About BIL</h2>
        <div class="space-y-6 text-lg md:text-xl font-bold leading-relaxed text-gray-800 uppercase">
          <p>
            Our company provides a high standard of lawn and cabin care services with a commitment to excellence. We strive to exceed our customers expectations with our quality service, attention to detail, and reliable customer service.
          </p>
          <p>
            We use the latest tools and techniques to ensure the best results for each project. Our team is highly experienced, insured, and dedicated to providing superior results that will leave you with a beautiful, healthy lawn and cabin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR SERVICES SECTION -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-black uppercase mb-4 inline-block border-b-4 border-black pb-2">Our Services</h2>
      <p class="text-xl font-bold uppercase text-gray-600 mb-16">We offer an array of lawn services. Contact us today to customize our services to meet your needs.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-left">
        <!-- Lawn Care -->
        <div class="bg-gray-100 p-8 rounded-xl shadow-md border-t-4 border-[#1b6b2b]">
          <h3 class="text-2xl font-black uppercase mb-4">Lawn Care</h3>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed mb-4">
            Our lawn care service is designed to provide you with a beautiful and healthy lawn that you can enjoy without the hassle of maintaining it yourself.
          </p>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed">
            Jordan is an experienced professional who is equipped with the tools and expertise to provide comprehensive lawn care service, including mowing, trimming, fertilization, and weed control.
          </p>
        </div>

        <!-- Commercial -->
        <div class="bg-gray-100 p-8 rounded-xl shadow-md border-t-4 border-[#1b6b2b]">
          <h3 class="text-2xl font-black uppercase mb-4">Commercial Properties</h3>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed mb-4">
            We offer top-quality lawn care services for commercial lots to ensure that your business always looks its best. We understand the importance of maintaining a clean and professional appearance.
          </p>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed">
            With our regular maintenance program, you can rest assured that your lawn will always be healthy and well-maintained, allowing you to focus on running your business.
          </p>
        </div>

        <!-- Cabin Care -->
        <div class="bg-gray-100 p-8 rounded-xl shadow-md border-t-4 border-[#1b6b2b]">
          <h3 class="text-2xl font-black uppercase mb-4">Exterior Cabin Care</h3>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed mb-4">
            Maintaining the exterior of your cabin is crucial to ensure its longevity and aesthetic appeal. 
          </p>
          <p class="font-bold text-gray-700 text-sm uppercase leading-relaxed">
            Let us help you make the most of your time away, call for a free estimate and customized service plan. By taking care of your cabin's exterior, you can enjoy its beauty and functionality for years to come.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM SECTION -->
  <section class="py-20 bg-black text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black uppercase mb-6 inline-block border-b-4 border-white pb-2">Contact Us</h2>
      <p class="text-xl font-bold uppercase mb-12">Contact us today for your free estimate or questions.</p>
      
      <form class="text-left space-y-6">
        <h3 class="font-black text-xl uppercase mb-4">Name</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block font-bold uppercase text-sm mb-2">First Name (Required)</label>
            <input type="text" required class="w-full p-4 text-black focus:outline-none focus:ring-4 focus:ring-[#1b6b2b]" />
          </div>
          <div>
            <label class="block font-bold uppercase text-sm mb-2">Last Name (Required)</label>
            <input type="text" required class="w-full p-4 text-black focus:outline-none focus:ring-4 focus:ring-[#1b6b2b]" />
          </div>
        </div>
        
        <div>
          <label class="block font-bold uppercase text-sm mb-2 mt-6">Email (Required)</label>
          <input type="email" required class="w-full p-4 text-black focus:outline-none focus:ring-4 focus:ring-[#1b6b2b]" />
        </div>

        <div>
          <label class="block font-bold uppercase text-sm mb-2 mt-6">Message (Required)</label>
          <textarea required rows="5" class="w-full p-4 text-black focus:outline-none focus:ring-4 focus:ring-[#1b6b2b]"></textarea>
        </div>

        <button type="submit" class="mt-8 bg-white text-black font-black uppercase px-10 py-4 rounded-full hover:bg-gray-200 transition">
          Send
        </button>
      </form>
    </div>
  </section>

</BaseLayout>
