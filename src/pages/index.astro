---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Lawn Care',
    description:
      'Consistent, professional lawn care that keeps your property looking sharp and your lawn healthy all season long.',
    image:
      'https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=1800&q=90',
    href: '/services/lawn-care/',
    label: 'Residential',
  },
  {
    number: '02',
    title: 'Cabin Care',
    description:
      'Reliable care for lake homes, cabins and vacation properties when you are there—and when you are not.',
    image:
      'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1800&q=90',
    href: '/services/cabin-care/',
    label: 'Lake Properties',
  },
  {
    number: '03',
    title: 'Commercial',
    description:
      'Professional grounds care that keeps your business property clean, welcoming and looking its best.',
    image:
      'https://images.unsplash.com/photo-1589923188900-85dae523342b?auto=format&fit=crop&w=1800&q=90',
    href: '/services/commercial/',
    label: 'Business',
  },
];

const values = [
  {
    number: '01',
    title: 'Quality Service',
  },
  {
    number: '02',
    title: 'Attention To Detail',
  },
  {
    number: '03',
    title: 'Insured & Experienced',
  },
];

const differences = [
  {
    number: '01',
    title: 'Reliable',
    text: 'Consistent service you can count on. Your property should never feel like an afterthought.',
  },
  {
    number: '02',
    title: 'Details Matter',
    text: 'Clean edges, finished spaces and attention to the little things that make a property stand out.',
  },
  {
    number: '03',
    title: 'Local Care',
    text: 'We understand the properties, seasons and expectations of the communities we serve.',
  },
];
---

<BaseLayout
  title="Best In Lawn | Lawn, Cabin & Property Care"
  description="Professional lawn, cabin and property care for homes, lake properties and businesses."
>

  <!-- =========================================================
       HERO
  ========================================================== -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src="https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=2400&q=90"
        alt="Freshly maintained green lawn"
      />
    </div>

    <div class="hero-shade"></div>

    <div class="container hero-inner">

      <div class="hero-top">
        <span class="eyebrow">Lawn • Cabin • Property Care</span>

        <div class="hero-location glass-pill">
          Proudly serving the Lakes Area
        </div>
      </div>

      <div class="hero-main">

        <div class="hero-title-wrap">
          <span class="floating-number">01</span>

          <h1 class="display hero-title">
            BEST<br />
            <span>IN</span><br />
            LAWN<span class="gold">.</span>
          </h1>
        </div>

        <div class="hero-card glass-card">
          <span class="card-kicker">THE BEST IN LAWN STANDARD</span>

          <p>
            Professional property care for lawns,
            cabins, lake homes and businesses.
          </p>

          <a href="#estimate" class="glass-button">
            Get A Free Estimate
            <span>↗</span>
          </a>
        </div>

      </div>

      <div class="hero-bottom">
        <span>PROPERTY CARE</span>
        <span>EST. WITH PRIDE</span>
        <span>SCROLL TO EXPLORE ↓</span>
      </div>

    </div>
  </section>


  <!-- =========================================================
       STATEMENT
  ========================================================== -->
  <section class="statement">
    <div class="container statement-grid">

      <div class="section-marker">
        <span>01</span>
        <small>THE STANDARD</small>
      </div>

      <div class="statement-content">

        <h2 class="display">
          MORE<br />
          THAN<br />
          <span class="serif">MOWING.</span>
        </h2>

        <div class="statement-card glass-light">

          <p>
            Your property is more than a yard. It is where you
            spend summer weekends, welcome friends, run your
            business and make memories.
          </p>

          <p>
            Best In Lawn provides dependable, detail-focused
            property care designed to keep your place looking
            its best.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- =========================================================
       SERVICES
  ========================================================== -->
  <section class="services">

    <div class="container services-top">

      <div class="section-marker">
        <span>02</span>
        <small>WHAT WE DO</small>
      </div>

      <div>
        <h2 class="display">
          CARE FOR<br />
          EVERY<br />
          <span class="serif">PROPERTY.</span>
        </h2>

        <p class="section-intro">
          Professional care for the places that matter most.
        </p>
      </div>

    </div>


    <div class="services-grid container">

      {services.map((service) => (
        <a href={service.href} class="service-card">

          <div class="service-photo">
            <img
              src={service.image}
              alt={service.title}
              loading="lazy"
            />
          </div>

          <div class="service-glass">

            <div class="service-topline">
              <span>{service.number}</span>
              <span>{service.label}</span>
            </div>

            <h3 class="display">
              {service.title}
            </h3>

            <p>
              {service.description}
            </p>

            <span class="service-arrow">
              Explore Service
              <b>↗</b>
            </span>

          </div>

        </a>
      ))}

    </div>

  </section>


  <!-- =========================================================
       ABOUT BIL — GLASS OVER GRASS
  ========================================================== -->
  <section class="about">

    <div class="about-bg">
      <img
        src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=2400&q=90"
        alt=""
        loading="lazy"
      />
    </div>

    <div class="about-shade"></div>

    <div class="container about-inner">

      <div class="about-heading">
        <span class="eyebrow">03 / ABOUT BIL</span>

        <h2 class="display">
          A HIGHER<br />
          STANDARD<br />
          OF <span class="serif">CARE.</span>
        </h2>
      </div>


      <div class="about-glass glass-card">

        <div class="about-photo">
          <img
            src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=90"
            alt="Beautifully maintained property"
            loading="lazy"
          />

          <div class="photo-label">
            BEST IN LAWN
          </div>
        </div>


        <div class="about-copy">

          <span class="card-kicker">
            BUILT FOR PROPERTIES WORTH CARING ABOUT
          </span>

          <p class="about-lead">
            Best In Lawn provides a high standard of lawn
            and cabin care with a commitment to excellence.
          </p>

          <p>
            We strive to exceed our customers' expectations
            through quality service, attention to detail and
            dependable customer care.
          </p>

          <p>
            We use the latest tools and techniques to deliver
            beautiful results while treating every property
            with the care and attention it deserves.
          </p>

          <a href="/about/" class="glass-button dark-button">
            Learn More About Best In Lawn
            <span>↗</span>
          </a>

        </div>

      </div>


      <div class="value-grid">

        {values.map((value) => (
          <div class="value-card glass-card">

            <span class="value-number">
              {value.number}
            </span>

            <strong>
              {value.title}
            </strong>

          </div>
        ))}

      </div>

    </div>

  </section>


  <!-- =========================================================
       DIFFERENCE
  ========================================================== -->
  <section class="difference">

    <div class="container">

      <div class="difference-heading">

        <div class="section-marker light-marker">
          <span>04</span>
          <small>THE DIFFERENCE</small>
        </div>

        <h2 class="display">
          WE<br />
          SHOW<br />
          <span class="serif">UP.</span>
        </h2>

      </div>


      <div class="difference-grid">

        {differences.map((item) => (
          <div class="difference-card glass-card">

            <span class="difference-number">
              {item.number}
            </span>

            <h3 class="display">
              {item.title}
            </h3>

            <p>
              {item.text}
            </p>

            <span class="card-line"></span>

          </div>
        ))}

      </div>

    </div>

  </section>


  <!-- =========================================================
       FEATURE IMAGE
  ========================================================== -->
  <section class="feature">

    <img
      src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=90"
      alt="Beautiful cared-for property"
      loading="lazy"
    />

    <div class="feature-shade"></div>

    <div class="container feature-inner">

      <div class="feature-card glass-card">

        <span class="card-kicker">
          THE BEST IN LAWN STANDARD
        </span>

        <h2 class="display">
          THIS IS<br />
          WHAT WELL-CARED-FOR<br />
          <span class="serif">LOOKS LIKE.</span>
        </h2>

      </div>

    </div>

  </section>


  <!-- =========================================================
       PROCESS
  ========================================================== -->
  <section class="process">

    <div class="container">

      <div class="process-heading">

        <div class="section-marker">
          <span>05</span>
          <small>HOW IT WORKS</small>
        </div>

        <h2 class="display">
          SIMPLE.<br />
          PROFESSIONAL.<br />
          <span class="serif">DONE.</span>
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card glass-light">
          <span>01</span>
          <h3>TELL US ABOUT YOUR PROPERTY</h3>
          <p>
            Tell us what you need, where you're located
            and what you want your property to look like.
          </p>
        </div>

        <div class="process-card glass-light">
          <span>02</span>
          <h3>GET YOUR ESTIMATE</h3>
          <p>
            We'll talk through the work and put together
            a straightforward estimate.
          </p>
        </div>

        <div class="process-card glass-light">
          <span>03</span>
          <h3>ENJOY YOUR PROPERTY</h3>
          <p>
            We take care of the work so you can spend
            your time enjoying the property instead.
          </p>
        </div>

      </div>

    </div>

  </section>


  <!-- =========================================================
       SERVICE AREAS
  ========================================================== -->
  <section class="areas">

    <div class="container areas-grid">

      <div>

        <span class="eyebrow dark-eyebrow">
          06 / SERVICE AREAS
        </span>

        <h2 class="display">
          PROUDLY<br />
          SERVING<br />
          <span class="serif">THE LAKES AREA.</span>
        </h2>

      </div>


      <div class="areas-card glass-light">

        <span>Moorhead</span>
        <span>Fargo</span>
        <span>West Fargo</span>
        <span>Horace</span>
        <span>Harwood</span>

        <a href="/areas/nisswa/">
          Nisswa
          <span>↗</span>
        </a>

        <span>Lakes Area</span>
        <span>And More</span>

      </div>

    </div>

  </section>


  <!-- =========================================================
       FINAL CTA
  ========================================================== -->
  <section class="final-cta" id="estimate">

    <div class="cta-bg">
      <img
        src="https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=2400&q=90"
        alt=""
        loading="lazy"
      />
    </div>

    <div class="cta-shade"></div>


    <div class="container cta-inner">

      <div class="cta-card glass-card">

        <span class="eyebrow">
          READY WHEN YOU ARE
        </span>

        <h2 class="display">
          MAKE YOUR<br />
          PROPERTY<br />
          THE <span class="serif">BEST.</span>
        </h2>

        <p>
          Tell us a little about your property and what you need.
          We'll take it from there.
        </p>

        <div class="cta-actions">

          <a
            href="tel:+17012386904"
            class="glass-button"
          >
            Call (701) 238-6904
            <span>↗</span>
          </a>

          <a
            href="mailto:bestinlawn@gmail.com"
            class="cta-email"
          >
            Email Best In Lawn →
          </a>

        </div>

      </div>

    </div>

  </section>

</BaseLayout>


<style>

/* ============================================================
   DESIGN TOKENS
============================================================ */

:global(:root) {
  --bil-green: #123b28;
  --bil-dark: #071c12;
  --bil-mid: #1d5a3d;
  --bil-sage: #b9d2ba;
  --bil-light-sage: #dce9d9;
  --bil-cream: #f5f2e9;
  --bil-white: #ffffff;
  --bil-text: #17251d;
  --bil-muted: #657168;
  --bil-gold: #d9bb72;
}


/* ============================================================
   GLOBAL
============================================================ */

:global(body) {
  background: var(--bil-cream);
}

.display {
  font-weight: 950;
  letter-spacing: -0.065em;
  line-height: 0.86;
}

.serif {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: 400;
  font-style: italic;
  letter-spacing: -0.04em;
}

.eyebrow,
.card-kicker,
.section-marker,
.hero-bottom,
.glass-pill {
  text-transform: uppercase;
  letter-spacing: 0.13em;
  font-weight: 850;
}

.eyebrow {
  font-size: 0.62rem;
}

.card-kicker {
  display: block;
  font-size: 0.56rem;
  color: rgba(255,255,255,0.68);
}

.container {
  width: min(1280px, calc(100% - 48px));
  margin: auto;
}


/* ============================================================
   GLASS SYSTEM
============================================================ */

.glass-card {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.20),
      rgba(255,255,255,0.075)
    );

  border: 1px solid rgba(255,255,255,0.30);

  box-shadow:
    0 25px 80px rgba(0,0,0,0.20),
    inset 0 1px 0 rgba(255,255,255,0.22);

  backdrop-filter: blur(20px) saturate(130%);
  -webkit-backdrop-filter: blur(20px) saturate(130%);
}

.glass-light {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.75),
      rgba(255,255,255,0.42)
    );

  border: 1px solid rgba(255,255,255,0.82);

  box-shadow:
    0 20px 60px rgba(18,59,40,0.09),
    inset 0 1px 0 rgba(255,255,255,0.8);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


/* ============================================================
   HERO
============================================================ */

.hero {
  position: relative;
  min-height: 900px;
  overflow: hidden;
  color: white;
  background: var(--bil-dark);
}

.hero-bg,
.about-bg,
.cta-bg {
  position: absolute;
  inset: 0;
}

.hero-bg img,
.about-bg img,
.cta-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-bg img {
  object-position: center;
  transform: scale(1.02);
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(7,28,18,0.68),
      rgba(7,28,18,0.18)
    ),
    linear-gradient(
      180deg,
      rgba(7,28,18,0.28),
      rgba(7,28,18,0.68)
    );
}

.hero-inner {
  position: relative;
  z-index: 2;
  min-height: 900px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-top: 42px;
  padding-bottom: 28px;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.glass-pill {
  padding: 13px 20px;
  border-radius: 999px;

  font-size: 0.55rem;

  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.24);

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}

.hero-main {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 60px;
  align-items: end;
}

.hero-title-wrap {
  position: relative;
}

.floating-number {
  position: absolute;
  top: -55px;
  left: 4px;

  font-size: 0.65rem;
  font-weight: 900;
  letter-spacing: 0.15em;

  color: rgba(255,255,255,0.65);
}

.hero-title {
  margin: 0;
  font-size: clamp(5rem, 12vw, 11rem);
}

.hero-title > span {
  color: var(--bil-sage);
}

.gold {
  color: var(--bil-gold) !important;
}

.hero-card {
  padding: 38px;
  margin-bottom: 10px;
  border-radius: 4px;
}

.hero-card p {
  margin: 22px 0 28px;

  font-size: 1rem;
  line-height: 1.75;

  color: rgba(255,255,255,0.87);
}

.glass-button {
  display: inline-flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;

  padding: 15px 18px;

  color: white;
  text-decoration: none;

  font-size: 0.63rem;
  font-weight: 900;
  letter-spacing: 0.11em;
  text-transform: uppercase;

  background: rgba(255,255,255,0.13);
  border: 1px solid rgba(255,255,255,0.34);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.glass-button:hover {
  transform: translateY(-3px);
  background: rgba(255,255,255,0.22);
}

.glass-button span {
  font-size: 1rem;
}

.hero-bottom {
  display: flex;
  justify-content: space-between;

  padding-top: 20px;

  border-top: 1px solid rgba(255,255,255,0.30);

  font-size: 0.55rem;
}


/* ============================================================
   STATEMENT
============================================================ */

.statement {
  padding: 145px 0;
  background: var(--bil-cream);
}

.statement-grid {
  display: grid;
  grid-template-columns: 23% 1fr;
  gap: 30px;
}

.section-marker {
  display: flex;
  flex-direction: column;
  gap: 10px;

  color: var(--bil-green);
}

.section-marker span {
  font-size: 1.9rem;
  letter-spacing: -0.07em;
}

.section-marker small {
  font-size: 0.55rem;
}

.statement-content h2 {
  margin: 0;
  font-size: clamp(4rem, 8vw, 8.5rem);
}

.statement-content h2 .serif {
  color: var(--bil-green);
}

.statement-card {
  max-width: 610px;
  margin: 55px 0 0 auto;
  padding: 34px;
}

.statement-card p {
  margin: 0 0 18px;
  color: var(--bil-muted);
  line-height: 1.8;
}

.statement-card p:last-child {
  margin-bottom: 0;
}


/* ============================================================
   SERVICES
============================================================ */

.services {
  padding: 140px 0;
  background: white;
}

.services-top {
  display: grid;
  grid-template-columns: 23% 1fr;
  gap: 30px;
  margin-bottom: 85px;
}

.services-top h2 {
  margin: 0;
  font-size: clamp(4rem, 8vw, 8rem);
}

.services-top h2 .serif {
  color: var(--bil-green);
}

.section-intro {
  max-width: 420px;
  margin-top: 35px;
  color: var(--bil-muted);
  line-height: 1.75;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.service-card {
  position: relative;
  min-height: 650px;
  overflow: hidden;

  color: white;
  text-decoration: none;

  background: var(--bil-dark);
}

.service-photo {
  position: absolute;
  inset: 0;
}

.service-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;

  transition:
    transform 0.8s cubic-bezier(0.2,0.7,0.2,1);
}

.service-card::after {
  content: '';
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      180deg,
      rgba(7,28,18,0.10),
      rgba(7,28,18,0.78)
    );
}

.service-card:hover .service-photo img {
  transform: scale(1.06);
}

.service-glass {
  position: absolute;
  z-index: 2;
  left: 18px;
  right: 18px;
  bottom: 18px;

  padding: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.20),
      rgba(255,255,255,0.07)
    );

  border: 1px solid rgba(255,255,255,0.28);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    0 20px 55px rgba(0,0,0,0.18);
}

.service-topline {
  display: flex;
  justify-content: space-between;

  color: rgba(255,255,255,0.70);

  font-size: 0.55rem;
  font-weight: 900;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.service-glass h3 {
  margin: 38px 0 18px;
  font-size: clamp(2.7rem, 4vw, 4.4rem);
}

.service-glass p {
  margin: 0 0 28px;
  color: rgba(255,255,255,0.82);
  line-height: 1.7;
  font-size: 0.88rem;
}

.service-arrow {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding-top: 18px;

  border-top: 1px solid rgba(255,255,255,0.22);

  font-size: 0.58rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.service-arrow b {
  font-size: 1rem;
}


/* ============================================================
   ABOUT
============================================================ */

.about {
  position: relative;
  overflow: hidden;
  padding: 145px 0;

  color: white;
  background: var(--bil-dark);
}

.about-bg img {
  transform: scale(1.03);
}

.about-shade {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(7,28,18,0.80),
      rgba(7,28,18,0.38)
    );
}

.about-inner {
  position: relative;
  z-index: 2;
}

.about-heading {
  margin-bottom: 55px;
}

.about-heading h2 {
  margin: 25px 0 0;
  font-size: clamp(4rem, 8vw, 8.5rem);
}

.about-heading .serif {
  color: var(--bil-sage);
}

.about-glass {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;

  overflow: hidden;
}

.about-photo {
  position: relative;
  min-height: 600px;
}

.about-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-label {
  position: absolute;
  left: 25px;
  bottom: 22px;

