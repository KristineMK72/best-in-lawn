---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Cabin Care & Vacation Property Maintenance | Best In Lawn";
const description = "Professional exterior cabin care, seasonal prep, and property maintenance.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-[#0f172a] py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-heading font-bold text-white mb-6">Exterior Cabin Care</h1>
      <p class="text-xl text-[#f8fafc] max-w-2xl mx-auto">Peace of mind for your retreat. We maintain it, you enjoy it.</p>
    </div>
  </section>
</BaseLayout>
