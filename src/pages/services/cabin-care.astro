---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Cabin Care & Vacation Property Maintenance | Best In Lawn";
const description = "Enjoy your time away. Professional exterior cabin care, seasonal prep, and property maintenance. Arrive to a pristine property, every time.";
---

<BaseLayout title={title} description={description}>
  <section class="relative bg-brand-forest py-24 flex items-center justify-center">
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-brand-dark/40 z-10"></div>
    <div class="absolute inset-0 overflow-hidden">
      <img 
        src="https://images.unsplash.com/photo-1542718610-a1d656d1884c?q=80&w=2000&auto=format&fit=crop" 
        alt="Lakeside cabin in the woods" 
        class="w-full h-full object-cover"
      />
    </div>
    
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6">Exterior Cabin Care</h1>
      <p class="text-xl text-white max-w-2xl mx-auto font-medium drop-shadow-md">
        Peace of mind for your retreat. We maintain it, you enjoy it.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <div>
          <h2 class="text-3xl font-heading font-bold text-brand-dark mb-6">Your Up-North Property Partner</h2>
          <p class="text-brand-earth text-lg mb-6 leading-relaxed">
            Your cabin should be a place of relaxation, not a destination for an endless weekend chore list. Our specialized exterior cabin care program is designed for absentee owners who want their property protected, maintained, and looking beautiful year-round.
          </p>
          <p class="text-brand-earth text-lg mb-8 leading-relaxed">
            From seasonal preparation to consistent upkeep, we handle the heavy lifting so your property is ready the moment you arrive.
          </p>
          
          <div class="space-y-4">
            <div class="p-4 bg-brand-light rounded-lg border-l-4 border-brand-leaf">
              <h4 class="font-bold text-brand-dark">Exterior Longevity</h4>
              <p class="text-sm text-brand-earth mt-1">Regular maintenance prevents overgrowth, protects your siding, and preserves property value.</p>
            </div>
            <div class="p-4 bg-brand-light rounded-lg border-l-4 border-brand-leaf">
              <h4 class="font-bold text-brand-dark">Visual Assurance</h4>
              <p class="text-sm text-brand-earth mt-1">Know that a trusted professional is keeping eyes on your property when you aren't there.</p>
            </div>
          </div>
        </div>

        <div class="bg-brand-dark text-brand-light p-10 rounded-xl shadow-2xl">
          <h3 class="text-2xl font-heading font-bold text-white mb-6 border-b border-gray-700 pb-4">Our Cabin Services</h3>
          <ul class="space-y-4">
            <li class="flex items-center">
              <svg class="w-6 h-6 text-brand-leaf mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Pre-arrival property prep & clearing</span>
            </li>
            <li class="flex items-center">
              <svg class="w-6 h-6 text-brand-leaf mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Post-storm visual checks</span>
            </li>
            <li class="flex items-center">
              <svg class="w-6 h-6 text-brand-leaf mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Deep seasonal cleanups (Spring/Fall)</span>
            </li>
            <li class="flex items-center">
              <svg class="w-6 h-6 text-brand-leaf mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Consistent lawn & brush maintenance</span>
            </li>
          </ul>
          <div class="mt-8 pt-6 border-t border-gray-700 text-center">
            <a href="/contact" class="text-brand-leaf font-bold hover:text-white transition uppercase tracking-wider text-sm">Discuss Your Cabin Plan &rarr;</a>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
