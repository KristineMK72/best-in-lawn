---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Expert Lawn Care & Maintenance | Best In Lawn";
const description = "Professional lawn mowing, trimming, weed control, and fertilization services.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-[#115e59] py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-heading font-bold text-white mb-6">Complete Lawn Care & Turf Management</h1>
      <p class="text-xl text-[#f8fafc] max-w-2xl mx-auto">Professional, reliable lawn maintenance tailored to your property.</p>
    </div>
  </section>
</BaseLayout>
