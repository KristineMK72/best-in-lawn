---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Commercial Lawn Care & Property Maintenance | Best In Lawn";
const description = "Keep your business looking pristine. Reliable commercial lawn maintenance.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-[#0f172a] py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-heading font-bold text-white mb-6">Commercial Property Maintenance</h1>
      <p class="text-xl text-[#f8fafc] max-w-2xl mx-auto">Elevate your business's first impression with professional groundskeeping.</p>
    </div>
  </section>
</BaseLayout>
