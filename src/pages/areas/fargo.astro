---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Lawn Care & Property Maintenance in Fargo, ND | Best In Lawn";
const description = "Top-rated lawn mowing, commercial property maintenance, and seasonal yard care for the Fargo-Moorhead area. Get your free estimate today.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-brand-light py-16 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-heading font-bold text-brand-dark mb-4">Lawn & Property Care in Fargo, ND</h1>
      <p class="text-lg text-brand-earth max-w-3xl">
        Proudly serving residential neighborhoods and commercial properties throughout Fargo. From Osgood to Northport, our local team provides reliable, high-quality turf management and property care.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-brand-dark mb-4">Fargo Services</h2>
          <ul class="space-y-3 mb-6">
            <li><a href="/services/lawn-care" class="text-brand-forest font-medium hover:underline">Residential Lawn Mowing & Trimming</a></li>
            <li><a href="/services/commercial" class="text-brand-forest font-medium hover:underline">Commercial Property Groundskeeping</a></li>
            <li><a href="/services/lawn-care" class="text-brand-forest font-medium hover:underline">Fertilization & Weed Control</a></li>
            <li><a href="/services/lawn-care" class="text-brand-forest font-medium hover:underline">Spring & Fall Cleanups</a></li>
          </ul>
          <a href="/contact" class="inline-block bg-brand-dark text-white px-6 py-2 rounded shadow hover:bg-brand-forest transition">Get a Fargo Estimate</a>
        </div>

        <div class="bg-brand-forest text-white p-8 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold mb-2">Own a Cabin Up North?</h3>
          <p class="text-brand-light text-sm mb-4">
            Many of our Fargo-Moorhead clients also own second homes in the Brainerd Lakes Area. We offer comprehensive absentee-owner cabin care so you can just show up and enjoy your weekend.
          </p>
          <a href="/services/cabin-care" class="text-brand-leaf font-bold hover:text-white transition">Learn about Cabin Care &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
