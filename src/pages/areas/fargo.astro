---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Lawn Care & Property Maintenance in Fargo, ND | Best In Lawn";
const description = "Top-rated lawn mowing and property maintenance for the Fargo-Moorhead area.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-[#f8fafc] py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-4xl font-heading font-bold text-[#0f172a] mb-4">Lawn & Property Care in Fargo, ND</h1>
      <p class="text-lg text-[#78716c]">Proudly serving residential neighborhoods and commercial properties throughout Fargo.</p>
    </div>
  </section>
</BaseLayout>
