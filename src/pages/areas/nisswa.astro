---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Cabin Care in Nisswa, MN | Best In Lawn";
const description = "Premium exterior cabin care and lawn maintenance for lake properties in Nisswa.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-[#f8fafc] py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-4xl font-heading font-bold text-[#0f172a] mb-4">Cabin & Property Care in Nisswa, MN</h1>
      <p class="text-lg text-[#78716c]">Serving the heart of the Brainerd Lakes Area with dedicated year-round property management.</p>
    </div>
  </section>
</BaseLayout>
