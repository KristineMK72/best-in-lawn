---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Best In Lawn | Lawn, Cabin & Property Care',
  description = 'Professional lawn, cabin and property care throughout the Lakes Area.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://bestinlawn.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/png" href="/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <style is:global>
      :root {
        --green: #123b28;
        --green-dark: #071c12;
        --green-mid: #28583e;
        --sage: #dfe9df;
        --cream: #f5f5ef;
        --white: #ffffff;
        --ink: #101713;
        --muted: #68736c;
        --line: #d8ded8;
        --gold: #b79a5b;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      * {
        box-sizing: border-box;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ::selection {
        background: var(--green);
        color: white;
      }

      .display {
        font-family: 'DM Sans', sans-serif;
        font-weight: 900;
        letter-spacing: -0.075em;
        line-height: 0.84;
      }

      .serif {
        font-family: 'Playfair Display', serif;
      }

      .eyebrow {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .section-number {
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.15em;
      }

      .container {
        width: min(1400px, calc(100% - 40px));
        margin-inline: auto;
      }

      .luxury-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        min-height: 58px;
        padding: 0 26px;
        border: 1px solid var(--green);
        background: var(--green);
        color: white;
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        transition:
          transform 180ms ease,
          background 180ms ease,
          color 180ms ease;
      }

      .luxury-button:hover {
        transform: translateY(-3px);
        background: var(--green-dark);
      }

      .luxury-button.light {
        border-color: white;
        background: white;
        color: var(--green-dark);
      }

      .luxury-button.light:hover {
        background: var(--sage);
      }

      .arrow {
        font-size: 1.1rem;
        line-height: 1;
      }

      .image-wrap {
        overflow: hidden;
      }

      .image-wrap img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 700ms cubic-bezier(.2,.7,.2,1);
      }

      .image-wrap:hover img {
        transform: scale(1.035);
      }

      @media (max-width: 768px) {
        .container {
          width: min(100% - 28px, 1400px);
        }

        .luxury-button {
          min-height: 54px;
          padding-inline: 20px;
        }
      }
    </style>
  </body>
</html>
